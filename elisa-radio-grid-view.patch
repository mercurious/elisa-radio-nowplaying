+                        border.width: 3
+                        border.color: Kirigami.Theme.highlightColor
+                    }
+                    Rectangle {
+                        visible: tile.isPlaying
+                        anchors.bottom: parent.bottom
+                        anchors.right: parent.right
+                        width: Kirigami.Units.iconSizes.medium
+                        height: width
+                        color: Kirigami.Theme.highlightColor
+
+                        Kirigami.Icon {
